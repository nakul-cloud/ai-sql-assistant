# =========================================================
# APPLICATION
# =========================================================
APP_ENV=development
APP_NAME=AI_SQL_ASSISTANT
APP_HOST=0.0.0.0
APP_PORT=8501
DEBUG=True

# =========================================================
# STREAMLIT
# =========================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# =========================================================
# GROQ (LLM Provider)
# =========================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# =========================================================
# FALLBACK PROVIDERS (OpenAI & Gemini)
# =========================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AGENT_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =========================================================
# SQL SERVER (MSSQL)
# =========================================================
# Your SQL Express instance
SQL_SERVER=NAKUL-16\SQLEXPRESS

# Recommended: create dedicated DB later
SQL_DATABASE=ai_sql_assistant

# Windows Authentication
SQL_TRUSTED_CONNECTION=yes

# ODBC Driver
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Encryption
SQL_ENCRYPT=yes
SQL_TRUST_CERTIFICATE=yes

# =========================================================
# SQLALCHEMY
# =========================================================
SQL_ECHO=False
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=20

# =========================================================
# QDRANT
# =========================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =========================================================
# QDRANT COLLECTIONS
# =========================================================
SCHEMA_COLLECTION=ai_sql_schema_index
QUERY_CACHE_COLLECTION=ai_sql_query_cache

# =========================================================
# EMBEDDING MODEL
# =========================================================
# Provider options: local (BAAI/bge-m3), openai, gemini
# Set to 'openai' or 'gemini' to avoid loading the 2GB local model on your laptop.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# =========================================================
# HUGGINGFACE OFFLINE MODE
# =========================================================
# Model is already downloaded locally — skip ALL internet checks on startup.
# This eliminates the ~10-15s delay from HuggingFace metadata HTTP requests.
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# =========================================================
# QUERY CACHE
# =========================================================
QUERY_CACHE_THRESHOLD=0.97

# =========================================================
# SCHEDULER
# =========================================================
ENABLE_SCHEDULER=True
REINDEX_HOUR=0
REINDEX_MINUTE=0

# =========================================================
# LOGGING
# =========================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =========================================================
# FILE UPLOADS
# =========================================================
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=100

# =========================================================
# CACHE
# =========================================================
CACHE_DIR=cache
DESCRIPTION_CACHE_FILE=indexing/description_cache.json

# =========================================================
# MEMORY
# =========================================================
MEM0_API_KEY=

